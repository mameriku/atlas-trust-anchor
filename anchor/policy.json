  },
  "target": {
    "repository": "mameriku/atlas",
    "repository_id": 1311516591,
    "visibility": "private"
  },
  "trigger": {
    "event": "workflow_dispatch",
    "actors": [
      "mameriku"
    ]
  },
  "credential": {
